# Gabarit d'environnement Preuvance — copier vers .env.local (jamais commité).
# Règle absolue : AUCUN secret dans ce fichier. Les clés vivent dans
# .env.local sur chaque poste, sous la responsabilité de son propriétaire.
# Chaque module est optionnel : sans sa clé, il devient no-op ou refuse
# explicitement — rien ne casse, rien n'est simulé.
# Vérifier son poste : npm run poste:verifier

# --- Analyse IA (pipeline GPT-5.6) -----------------------------------------
# Sans OPENAI_API_KEY : le dossier instantané refuse avec un message clair,
# la démo /demo reste disponible.
OPENAI_API_KEY=
OPENAI_REASONING_MODEL=gpt-5.6-sol
OPENAI_ANCILLARY_MODEL=gpt-5.6-luna
OPENAI_REASONING_EFFORT=high
OPENAI_REQUEST_TIMEOUT_MS=90000

# --- Persistance (Supabase) -------------------------------------------------
# Sans ces clés : pas de compte ni de sauvegarde, le reste fonctionne.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Origine publique de l'application : fait AUTORITÉ en production (canoniques,
# sitemap, JSON-LD, images OpenGraph). Sans elle, l'origine est dérivée de
# l'en-tête `host` de la requête — acceptable en développement seulement.
NEXT_PUBLIC_APP_URL=http://localhost:3000

# --- Mesure produit (PostHog : jamais de texte libre) -----------------------
# Sans clé, aucun script n'est chargé et aucun événement n'est envoyé.
# phc_ = clé projet d'ingestion (exposée au navigateur, pas un secret).
NEXT_PUBLIC_POSTHOG_KEY=
NEXT_PUBLIC_POSTHOG_HOST=https://us.i.posthog.com
# phx_ = clé personnelle du script de provisionnement (npm run analytics:setup).
# Ne JAMAIS la préfixer NEXT_PUBLIC_ : elle ne doit pas atteindre le navigateur.
POSTHOG_PERSONAL_API_KEY=
POSTHOG_PROJECT_ID=
POSTHOG_API_HOST=https://us.posthog.com

# --- Console interne (équipe uniquement) ------------------------------------
# PREUVANCE_OPS=1 fait exister la console /ops sur CE poste (sinon : 404).
# Ne jamais poser cette variable sur un déploiement public.
PREUVANCE_OPS=

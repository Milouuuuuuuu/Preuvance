{
  "compilerOptions": {
    "target": "ES2017",
    "lib": ["dom", "dom.iterable", "esnext"],
    "allowJs": true,
    "skipLibCheck": true,
    "strict": true,
    "noEmit": true,
    "esModuleInterop": true,
    "module": "esnext",
    "moduleResolution": "bundler",
    "resolveJsonModule": true,
    "isolatedModules": true,
    "jsx": "react-jsx",
    "incremental": true,
    "plugins": [
      {
        "name": "next"
      }
    ],
    "paths": {
      "@/*": ["./*"]
    }
  },
  // `next-env.d.ts` et `.next/**` n'existent pas ici : le build passe par
  // vinext, qui écrit dans `.vinext` (exclu plus bas). Les garder faisait
  // mentir la configuration sur ce qu'elle compile (audit 26/07/2026, DT-03).
  "include": ["**/*.ts", "**/*.tsx", "**/*.mts"],
  "exclude": ["node_modules", "dist", ".vinext", ".wrangler", "outputs", "public", "remotion"]
}
